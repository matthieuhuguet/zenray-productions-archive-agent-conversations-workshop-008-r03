e,f) pour Image.transform(AFFINE) : pour chaque\n    pixel de sortie (bx,by), le pixel source lu est (a*bx+b*by+c, d*bx+e*by+f).\n    Derive directement de la meme chaine que le CSS : object-fit:cover +\n    object-position(px,py) puis transform: scale(zoom*safescale) rotate(angle)\n    autour du centre. `safescale` regonfle la couverture pour qu'aucune\n    rotation ne laisse un coin transparent (meme formule que le JS du picker,\n    a ne jamais faire diverger) :\n        safescale = |cos angle| + max(H/W, W/H) * |sin angle|\n    Angle positif = sens CSS (horaire), coherent avec `rotate(Xdeg)`.\n    \"\"\"\n    s = max(canvas_w / nw, canvas_h / nh)\n    x0 = (nw - canvas_w / s) * (px / 100)\n    y0 = (nh - canvas_h / s) * (py / 100)\n\n    ratio = max(canvas_h / canvas_w, canvas_w / canvas_h)\n    theta = math.radians(angle_deg)\n    safescale = abs(math.cos(theta)) + ratio * abs(math.sin(theta))\n    safescale *= 1.002  # marge anti-arrondi\n\n    z = zoom * safescale\n    cx, cy = canvas_w / 2, canvas_h / 2\n    cos_t, sin_t = math.cos(theta), math.sin(theta)\n\n    a = cos_t / (z * s)\n    b = sin_t / (z * s)\n    c = x0 + cx / s - (cos_t * cx + sin_t * cy) / (z * s)\n    d = -sin_t / (z * s)\n    e = cos_t / (z * s)\n    f = y0 + cy / s + (sin_t * cx - cos_t * cy) / (z * s)\n    return (a, b, c, d, e, f)\n\n\ndef load_font(font_key, weight, size):\n    size = max(1, round(size))\n    if font_key == \"sans\":\n        font = ImageFont.truetype(SANS_FONT_FILE, size)\n        try:\n            font.set_variation_by_axes([weight])  # InterVariable, axe wght natif\n        except Exception:\n            pass\n        return font\n    nearest = min(SERIF_FONT_FILES, key=lambda w: abs(w - weight))\n    return ImageFont.truetype(SERIF_FONT_FILES[nearest], size)\n\n\ndef position_for(bbox, h_anchor, v_anchor, canvas_w, canvas_h, margin_x, margin_y):\n    \"\"\"Coin haut-gauche (x,y) du texte pour dessiner `bbox` a l'ancre donnee.\n    Meme convention que le CSS (text-align + top/middle/bottom + marge 6%).\"\"\"\n    text_w, text_h = bbox[2] - bbox[0], bbox[3] - bbox[1]\n    if h_anchor == \"left\":\n        x = margin_x - bbox[0]\n    elif h_anchor == \"right\":\n        x = canvas_w - margin_x - text_w - bbox[0]\n    else:\n        x = (canvas_w - text_w) / 2 - bbox[0]\n    if v_anchor == \"top\":\n        y = margin_y - bbox[1]\n    elif v_anchor == \"middle\":\n        y = (canvas_h - text_h) / 2 - bbox[1]\n    else:\n        y = canvas_h - margin_y - text_h - bbox[1]\n    return x, y\n\n\ndef draw_captions(canvas, text_cfgs, canvas_w, canvas_h):\n    \"\"\"Dessine 0 a N calques de texte, dans l'ordre donne (T1 puis T2 puis T3).\n    Accepte aussi l'ancien format mono-calque (un dict au lieu d'une liste).\"\"\"\n    if not text_cfgs:\n        return canvas\n    if isinstance(text_cfgs, dict):\n        text_cfgs = [text_cfgs]\n    for text_cfg in text_cfgs:\n        canvas = draw_caption(canvas, text_cfg, canvas_w, canvas_h)\n    return canvas\n\n\ndef draw_caption(canvas, text_cfg, canvas_w, canvas_h):\n    if not text_cfg or not text_cfg.get(\"value\", \"\").strip():\n        return canvas\n    if \"enabled\" in text_cfg and not text_cfg.get(\"enabled\"):\n        return canvas\n    value = text_cfg[\"value\"].strip()\n    font_key = text_cfg.get(\"font\", \"serif\")\n    weight = int(text_cfg.get(\"weight\", 400))\n    color = text_cfg.get(\"color\", \"#f6cf47\")\n    v_anchor, h_anchor = (text_cfg.get(\"anchor\") or \"bottom-center\").split(\"-\")\n    margin_x, margin_y = canvas_w * 0.06, canvas_h * 0.06\n    max_width = canvas_w * 0.88\n\n    # Auto-fit : jamais l'inverse. Part de la taille demandee (px, dans\n    # l'espace du canevas de sortie, meme convention que le curseur JS) et la\n    # retrecit tant que la boite de texte deborde la largeur padee OU les\n    # bords memes du cadre (0..canvas_w, 0..canvas_h). La police ne sort\n    # jamais du cadre pour \"cropper\" le texte, elle s'adapte a la taille\n    # maximale qui tient.\n    font_size = round(text_cfg.get(\"size_px\", 200))\n    probe = ImageDraw.Draw(canvas)\n\n    def fits(bbox):\n        text_w = bbox[2] - bbox[0]\n        if text_w > max_width:\n            return False\n        x, y = position_for(bbox, h_anchor, v_anchor, canvas_w, canvas_h, margin_x, margin_y)\n        left, top = x + bbox[0], y + bbox[1]\n        right, bottom = x + bbox[2], y + bbox[3]\n        return left >= 0 and top >= 0 and right <= canvas_w and bottom <= canvas_h\n\n    font = load_font(font_key, weight, font_size)\n    bbox = probe.textbbox((0, 0), value, font=font)\n    while not fits(bbox) and font_size > MIN_FONT_SIZE_PX:\n        font_size -= 2\n        font = load_font(font_key, weight, font_size)\n        bbox = probe.textbbox((0, 0), value, font=font)\n\n    x, y = position_for(bbox, h_anchor, v_anchor, canvas_w, canvas_h, margin_x, margin_y)\n\n    canvas = canvas.convert(\"RGBA\")\n    shadow = Image.new(\"RGBA\", canvas.size, (0, 0, 0, 0))\n    ImageDraw.Draw(shadow).text((x, y), value, font=font, fill=(0, 0, 0, 200))\n    shadow = shadow.filter(ImageFilter.GaussianBlur(canvas_w * 0.004))\n    canvas = Image.alpha_composite(canvas, shadow)\n    ImageDraw.Draw(canvas).text((x, y), value, font=font, fill=color)\n    return canvas.convert(\"RGB\")\n\n\ndef main():\n    index = json.loads((HERE / \"_index.json\").read_text())\n    params = json.loads((HERE / \"_crop_params.json\").read_text())\n    by_id = {img[\"id\"]: img for img in index[\"images\"]}\n\n    fmt = params[\"format\"]\n    canvas_w = fmt[\"w\"] * fmt[\"factor\"]\n    canvas_h = fmt[\"h\"] * fmt[\"factor\"]\n\n    OUT_DIR.mkdir(exist_ok=True)\n    written = []\n    for p in params[\"images\"]:\n        entry = by_id.get(p[\"id\"])\n        if entry is None:\n            raise SystemExit(f\"id {p['id']} absent de _index.json\")\n        src_path = Path(entry[\"path\"])\n        if not src_path.exists():\n            src_path = SOURCE_DIR / entry[\"file\"]\n        assert src_path.exists(), f\"source introuvable : {src_path}\"\n\n        im = Image.open(src_path)\n        im = ImageOps.exif_transpose(im)  # aligne sur ce qu'affiche un navigateur (EXIF)\n        im = im.convert(\"RGB\")\n        nw, nh = im.size\n\n        coeffs = affine_coeffs(nw, nh, canvas_w, canvas_h, p[\"x\"], p[\"y\"], p[\"zoom\"], p.get(\"rotate\", 0))\n        out = im.transform((canvas_w, canvas_h), Image.AFFINE, data=coeffs, resample=Image.BICUBIC)\n        out = draw_captions(out, p.get(\"text\"), canvas_w, canvas_h)\n\n        out_path = OUT_DIR / f'{p[\"id\"]}-{Path(entry[\"file\"]).stem}.jpg'\n        quality = 95\n        out.save(out_path, \"JPEG\", quality=quality, optimize=True)\n        size_mb = out_path.stat().st_size / 1_048_576\n        while size_mb > 8 and quality > 60:\n            quality -= 5\n            out.save(out_path, \"JPEG\", quality=quality, optimize=True)\n            size_mb = out_path.stat().st_size / 1_048_576\n\n        written.append(out_path)\n        print(f\"{out_path.name}: {out.size[0]}x{out.size[1]}  q{quality}  {size_mb:.2f} Mo\")\n\n    print(f\"\\n{len(written)} images ecrites dans {OUT_DIR}\")\n\n\nif __name__ == \"__main__\":\n    main()\nfinal (`Image.transform(..., Image.AFFINE, data=affine_coeffs(...))`), pas un\nenchaînement crop-resize-rotate-crop : plus exact, plus simple, et ça évite\nd'accumuler l'arrondi de plusieurs rééchantillonnages. `affine_coeffs()`\nreproduit exactement la chaîne CSS du picker (`object-fit:cover` +\n`object-position` + `transform: scale(zoom·safescale) rotate(angle)`,\ntransform-origin centre) :\n\n- facteur de couverture `s = max(Fw/Nw, Fh/Nh)` ;\n- décalage de couverture `x0,y0` fixé par `x%`/`y%` ;\n- `safescale = |cos θ| + max(Fh/Fw, Fw/Fh)·|sin θ|`, le facteur EXACT (pas\n  une simple marge de sécurité) qui regonfle la couverture pour qu'une\n  rotation de θ ne laisse jamais un coin transparent dans le cadre\n  `overflow:hidden` ; petite marge `×1.002` en plus pour l'arrondi ;\n- `Z = zoom · safescale` est le facteur combiné réellement appliqué par le\n  CSS (`scale(var(--zoom) * var(--safescale))` côté HTML, `--safescale`\n  recalculé à chaque changement d'angle ET de format) ;\n- angle positif = sens CSS (horaire), aucune inversion de signe nécessaire\n  entre le JS et Python tant que la même convention `R(θ)=[[cosθ,-sinθ],\n  [sinθ,cosθ]]` en repère y-vers-le-bas est utilisée des deux côtés.\n\nIl applique toujours `ImageOps.exif_transpose()` avant de mesurer les\ndimensions sources, sinon une photo iPhone orientée par tag EXIF se recadre\nsur les mauvaises dimensions. Sortie en JPEG qualité 95, avec le même repli de\npoids que `render.sh` (redescend la qualité par paliers de 5 tant que le\nfichier dépasse 8 Mo).\n\n**Texte optionnel par image, câblé le 2026-08-31, passé en calques multiples\nle 2026-09-01.** Chaque calque porte : champ libre, police Serif\n(`AnthropicSerif`) ou Sans (`InterVariable`), sept graisses réelles, taille en\n**px libre** avec auto-fit (voir plus bas), couleur **jaune `#f6cf47`** (nommé\npar Matthieu « Plastic Chinese color ») ou **blanc**, et son ancre. Marge de\n6 % par rapport aux bords, quel que soit l'ancrage ; ombre portée douce (flou\ngaussien noir semi-transparent derrière le texte) pour rester lisible sur une\nphoto chargée. La ligne de paramètres copiée gagne une ligne indentée par\ncalque :\n`T1 text=\"…\" font=serif|sans weight=300..900 size=<px-effectif>px color=#f6cf47|#ffffff anchor=…`.\n\n**Jusqu'à TROIS calques de texte, ajoutés au bouton `+` (2026-09-01).**\nDemande de Matthieu, valable **light ET heavy** : « il me faut aussi un autre\nbouton + pour ajouter un 2ème voire un 3ème texte ». Aucun calque n'existe par\ndéfaut, le bouton `+ Ajouter un texte` en crée un, chacun a son bouton\n`Supprimer`, et le bouton se désactive en affichant « (3 maximum) » une fois le\nplafond atteint. Trois points de conception qui comptent :\n\n- **L'ancre par défaut change d'un calque à l'autre**, `bottom-center`, puis\n  `top-center`, puis `middle-center`. Deux textes ajoutés coup sur coup ne\n  doivent pas se superposer au même endroit, sans quoi le second paraît absent\n  et l'outil paraît cassé.\n- **Chaque calque est auto-fitté indépendamment** : un titre trop long rétrécit\n  seul, sans toucher aux autres.\n- **Un changement de format ramène TOUS les calques** sur une ancre valide,\n  pas seulement celui qu'on regarde (portrait ou carré = colonne du centre\n  uniquement).\n\nLe cook accepte les deux formes : `draw_captions()` boucle sur une liste de\ncalques et tolère encore un dict unique, pour ne pas casser un\n`_crop_params.json` écrit avant cette date. Non-régression vérifiée le\n2026-09-01, les neuf images regénérées après le passage aux calques multiples\nsont bit-identiques aux précédentes.\n\n**L'ancre du texte, ajoutée le 2026-08-31 après un premier oubli.** Le\npositionnement fixe en bas manquait un réglage : Matthieu a demandé un choix\nd'ancrage vertical, et une règle de nombre d'ancres qui dépend du format.\nNeuf valeurs canoniques couvrent tous les cas,\n`{top,middle,bottom}-{left,center,right}`, stockées telles quelles dans\n`img.text.anchor` (défaut `bottom-center`, comportement identique à avant\nl'ajout) :\n\n- **format portrait ou carré** (largeur ≤ hauteur, donc 4:5, 1:1, 9:16, 1:2,\n  3:4, 2:3) : seule la colonne du centre a un sens, le widget n'expose QUE\n  trois ancres, **Haut / Milieu / Bas**, toutes `*-center` ;\n- **format horizontal** (largeur > hauteur, donc 16:9, 4:3) : le widget\n  s'ouvre aux neuf ancres, grille 3×3.\n\nLe widget est un simple bloc de 9 boutons carrés (`data-anchor=\"top-left\"`,\netc.) dans une grille CSS 3×3 ; en mode portrait, seule la colonne du centre\nreste visible (`display:none` sur les boutons `*-left`/`*-right` via un\nsélecteur d'attribut `[data-anchor$=\"-left\"]`), sans réordonner le DOM. Un\nchangement de format qui fait passer du mode 9 au mode 3 **clampe**\nautomatiquement une ancre non centrée vers son équivalent centré (`top-left`\ndevient `top-center`) plutôt que de laisser une ancre invalide active. Côté\nCSS, l'ancre se traduit en deux classes indépendantes sur `.text-overlay`,\n`anchor-v-{top|middle|bottom}` (position `top`/`transform:translateY(-50%)`\nsur `top:50%`/`bottom`) et `anchor-h-{left|center|right}` (`text-align`\nseulement, la boîte de texte reste pleine largeur avec son padding de 6 % de\nchaque côté). Côté `crop-apply.py`, `draw_caption()` lit `text_cfg[\"anchor\"]`,\nsépare `v_anchor, h_anchor = anchor.split(\"-\")` et calcule `x`/`y` en\nconséquence, mêmes marges de 6 % ; testé visuellement en `top-left` et en\n`middle-center` sur un format 16:9, texte exactement où attendu, ombre lisible\ndans les deux cas.\n\n**Sept graisses réelles et taille en px avec auto-fit, ajoutées le\n2026-09-01, valables pour la version HDA light comme pour une future version\nheavy.** Deux demandes de Matthieu tenues ensemble : un choix de graisse\ncomplet (« Light / Regular / jusqu'à ExtraBold, tous »), et une taille en px\nqui « ne dépasse jamais le cadre, ça sort jamais du cadre pour faire une font\ncrop ».\n\n*Graisse.* Sept crans réels, jamais de gras synthétique :\n","exit_code":0,"duration":{"secs":0,"nanos":5292},"formatted_output":"#!/usr/bin/env python3\n# 2026-08-31, cook zenray-html-hda : _index.json + _crop_params.json -> JPEG finaux dans out/\n# Reproduit exactement le rendu CSS du picker (object-fit:cover + object-position\n# + transform: scale(zoom*safescale) rotate(angle)) par une seule transformation\n# affine directe source -> canevas final, pour que le fichier livré corresponde\n# au pixel pres a ce que Matthieu a vu dans le navigateur. Porte aussi le texte\n# optionnel (police Serif/Sans, 7 graisses reelles Light a Black, taille en\n# px avec auto-fit qui ne depasse jamais le cadre, couleur jaune #f6cf47 ou\n# blanc, ancre haut/milieu/bas x gauche/centre/droite).\nimport json\nimport math\nfrom pathlib import Path\n\nfrom PIL import Ima