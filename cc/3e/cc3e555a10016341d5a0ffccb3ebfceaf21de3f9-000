PLY HEAD\n#!/usr/bin/env python3\n# 2026-09-01, cook zenray-html-hda mode HEAVY : _index.json + _params.json -> JPEG finaux dans out/\n#\n# PORTAGE FIDELE du shader WebGL de `zr-photo-adjustments.js` en numpy. Le meme\n# ordre d'operations, les memes constantes et les memes formules, sinon l'apercu\n# du navigateur et le fichier livre divergent, ce qui viderait de son sens le\n# reglage a l'oeil. Ordre du shader, a ne jamais reordonner :\n#   levels -> selective color -> light -> saturation -> vibrance\n#   -> black and white -> filtre -> vignette -> clamp\n#\n# Le texte suit la meme chaine que `crop-apply.py` : police Serif/Sans, sept\n# graisses reelles, taille en px avec auto-fit qui ne depasse JAMAIS le cadre,\n# ancre haut/milieu/bas x gauche/centre/droite, jusqu'a trois calques par image.\n#\n# Les images sont ecrites sous `<nom d'origine>_<NN>` ou NN est la position dans\n# l'ordre choisi par glisser-deposer, la sortie portant donc l'ordre dans son nom.\nimport json\nimport math\nimport sys\nfrom pathlib import Path\n\nimport numpy as np\nfrom PIL import Image, ImageDraw, ImageFilter, ImageFont, ImageOps\n\nHERE = Path(__file__).resolve().parent\nSOURCE_DIR = HERE.parent\nOUT_DIR = HERE / \"out\"\n\nSERIF_FONT_FILES = {\n    300: \"/Users/zenray/Library/Fonts/AnthropicSerif-Light.ttf\",\n    400: \"/Users/zenray/Library/Fonts/AnthropicSerif-Regular.ttf\",\n    500: \"/Users/zenray/Library/Fonts/AnthropicSerif-Medium.ttf\",\n    600: \"/Users/zenray/Library/Fonts/AnthropicSerif-SemiBold.ttf\",\n    700: \"/Users/zenray/Library/Fonts/AnthropicSerif-Bold.ttf\",\n    800: \"/Users/zenray/Library/Fonts/AnthropicSerif-ExtraBold.ttf\",\n    900: \"/Users/zenray/Library/Fonts/AnthropicSerif-Black.ttf\",\n}\nSANS_FONT_FILE = \"/Users/zenray/Library/Fonts/InterVariable.ttf\"\nMIN_FONT_SIZE_PX = 6\n\nFILTERS = [\n    \"Original\", \"Vivid\", \"Vivid Warm\", \"Vivid Cool\", \"Dramatic\",\n    \"Dramatic Warm\", \"Dramatic Cool\", \"Mono\", \"Silvertone\", \"Noir\",\n]\nLUMA = np.array([0.2126, 0.7152, 0.0722], dtype=np.float32)\nSELECTIVE_CENTERS = [0.0, 0.1666667, 0.3333333, 0.5, 0.6666667, 0.8333333]\n\n\n# ---------------------------------------------------------------- helpers GLSL\n\ndef smoothstep(edge0, edge1, x):\n    \"\"\"Equivalent exact de smoothstep GLSL, y compris quand edge0 > edge1.\"\"\"\n    t = np.clip((x - edge0) / (edge1 - edge0), 0.0, 1.0)\n    return t * t * (3.0 - 2.0 * t)\n\n\ndef luma(color):\n    # Somme explicite plutot que `color @ LUMA` : sur macOS, le matmul BLAS leve\n    # des RuntimeWarning (divide by zero, overflow, invalid value) meme sur des\n    # donnees parfaitement finies, faux positif verifie le 2026-09-01. Les deux\n    # ecritures donnent le meme resultat au bit pres, celle-ci ne ment pas.\n    return color[..., 0] * LUMA[0] + color[..., 1] * LUMA[1] + color[..., 2] * LUMA[2]\n\n\ndef rgb_to_hsv(color):\n    r, g, b = color[..., 0], color[..., 1], color[..., 2]\n    maximum = np.max(color, axis=-1)\n    minimum = np.min(color, axis=-1)\n    delta = maximum - minimum\n    epsilon = 1.0e-10\n\n    hue = np.zeros_like(maximum)\n    mask = delta > epsilon\n    with np.errstate(invalid=\"ignore\", divide=\"ignore\"):\n        red_max = mask & (maximum == r)\n        green_max = mask & (maximum == g) & ~red_max\n        blue_max = mask & ~red_max & ~green_max\n        hue[red_max] = ((g - b)[red_max] / delta[red_max]) % 6.0\n        hue[green_max] = ((b - r)[green_max] / delta[green_max]) + 2.0\n        hue[blue_max] = ((r - g)[blue_max] / delta[blue_max]) + 4.0\n    hue = hue / 6.0\n    saturation = np.where(maximum > epsilon, delta / (maximum + epsilon), 0.0)\n    return np.stack([hue, saturation, maximum], axis=-1)\n\n\ndef hsv_to_rgb(color):\n    h, s, v = color[..., 0], color[..., 1], color[..., 2]\n    p = np.abs(((h[..., None] + np.array([0.0, 0.6666667, 0.3333333], dtype=np.float32)) % 1.0) * 6.0 - 3.0)\n    return (v[..., None] * (1.0 + s[..., None] * (np.clip(p - 1.0, 0.0, 1.0) - 1.0))).astype(np.float32)\n\n\ndef hue_distance(a, b):\n    difference = np.abs(a - b)\n    return np.minimum(difference, 1.0 - difference)\n\n\ndef adjust_saturation(color, amount):\n    gray = luma(color)[..., None]\n    factor = max(0.0, 1.0 + amount)\n    return gray + (color - gray) * factor\n\n\ndef apply_preset(color, filter_id):\n    gray = luma(color)[..., None]\n    if filter_id == 1:\n        return adjust_saturation((color - 0.5) * 1.08 + 0.5, 0.20)\n    if filter_id == 2:\n        return adjust_saturation((color - 0.5) * 1.07 + 0.5 + np.array([0.035, 0.012, -0.025], dtype=np.float32), 0.18)\n    if filter_id == 3:\n        return adjust_saturation((color - 0.5) * 1.07 + 0.5 + np.array([-0.025, 0.005, 0.035], dtype=np.float32), 0.18)\n    if filter_id == 4:\n        return adjust_saturation((color - 0.5) * 1.22 + 0.5, -0.08)\n    if filter_id == 5:\n        return adjust_saturation((color - 0.5) * 1.21 + 0.5 + np.array([0.045, 0.012, -0.035], dtype=np.float32), -0.05)\n    if filter_id == 6:\n        return adjust_saturation((color - 0.5) * 1.21 + 0.5 + np.array([-0.035, 0.004, 0.045], dtype=np.float32), -0.05)\n    if filter_id == 7:\n        return np.repeat(gray, 3, axis=-1)\n    if filter_id == 8:\n        return np.repeat(gray, 3, axis=-1) * np.array([1.06, 1.02, 0.92], dtype=np.float32) \\\n            + np.array([0.015, 0.01, 0.0], dtype=np.float32)\n    if filter_id == 9:\n        return np.repeat(smoothstep(0.18, 0.82, gray), 3, axis=-1)\n    return color\n\n\n# ------------------------------------------------------------- chaine photo\n\ndef apply_photo(image, photo):\n    \"\"\"Rejoue la chaine du shader sur un tableau HxWx3 en float32 (0..1).\"\"\"\n    if photo is None:\n        return image\n\n    def pct(key, default=0.0):\n        return float(photo.get(key, default)) / 100.0\n\n    levels = photo.get(\"levels\") or {}\n    color = image\n\n    # 1. Levels\n    input_black = float(levels.get(\"inputBlack\", 0)) / 100.0\n    midtone = float(levels.get(\"midtone\", 50)) / 100.0\n    input_white = max(input_black + 0.001, float(levels.get(\"inputWhite\", 100)) / 100.0)\n    output_black = float(levels.get(\"outputBlack\", 0)) / 100.0\n    output_white = float(levels.get(\"outputWhite\", 100)) / 100.0\n    color = np.clip((color - input_black) / (input_white - input_black), 0.0, 1.0)\n    gamma = 2.0 ** ((0.5 - midtone) * 3.0)\n    color = np.power(np.maximum(color, 1e-5), gamma)\n    color = output_black + (output_white - output_black) * color\n\n    # 2. Selective Color\n    selective = photo.get(\"selective\") or []\n    if any(any(float(channel.get(k, 0)) for k in (\"hue\", \"saturation\", \"luminance\")) for channel in selective):\n        hsv = rgb_to_hsv(color)\n        for index, center in enumerate(SELECTIVE_CENTERS):\n            channel = selective[index] if index < len(selective) else {}\n            hue_amount = float(channel.get(\"hue\", 0)) / 100.0\n            sat_amount = float(channel.get(\"saturation\", 0)) / 100.0\n            lum_amount = float(channel.get(\"luminance\", 0)) / 100.0\n            if not (hue_amount or sat_amount or lum_amount):\n                continue\n            weight = smoothstep(0.19, 0.0, hue_distance(hsv[..., 0], center)) \\\n                * smoothstep(0.05, 0.25, hsv[..., 1])\n            hsv[..., 0] = (hsv[..., 0] + hue_amount * weight * 0.12 + 1.0) % 1.0\n            hsv[..., 1] = np.clip(hsv[..., 1] + sat_amount * weight * 0.55, 0.0, 1.0)\n            hsv[..., 2] = np.clip(hsv[..., 2] + lum_amount * weight * 0.38, 0.0, 1.0)\n        color = hsv_to_rgb(hsv)\n\n    # 3. Light. `luminosity` est mesuree UNE fois, avant les operations, comme\n    #    dans le shader : la recalculer entre deux etapes changerait le rendu.\n    brilliance = pct(\"brilliance\")\n    exposure = pct(\"exposure\")\n    highlights = pct(\"highlights\")\n    shadows = pct(\"shadows\")\n    brightness = pct(\"brightness\")\n    contrast = pct(\"contrast\")\n    black_point = pct(\"blackP