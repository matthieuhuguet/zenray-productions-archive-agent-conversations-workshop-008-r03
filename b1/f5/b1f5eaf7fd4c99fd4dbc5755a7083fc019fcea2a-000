by zero, overflow, invalid value) meme sur des\n    # donnees parfaitement finies, faux positif verifie le 2026-09-01. Les deux\n    # ecritures donnent le meme resultat au bit pres, celle-ci ne ment pas.\n    return color[..., 0] * LUMA[0] + color[..., 1] * LUMA[1] + color[..., 2] * LUMA[2]\n\n\ndef rgb_to_hsv(color):\n    r, g, b = color[..., 0], color[..., 1], color[..., 2]\n    maximum = np.max(color, axis=-1)\n    minimum = np.min(color, axis=-1)\n    delta = maximum - minimum\n    epsilon = 1.0e-10\n\n    hue = np.zeros_like(maximum)\n    mask = delta > epsilon\n    with np.errstate(invalid=\"ignore\", divide=\"ignore\"):\n        red_max = mask & (maximum == r)\n        green_max = mask & (maximum == g) & ~red_max\n        blue_max = mask & ~red_max & ~green_max\n        hue[red_max] = ((g - b)[red_max] / delta[red_max]) % 6.0\n        hue[green_max] = ((b - r)[green_max] / delta[green_max]) + 2.0\n        hue[blue_max] = ((r - g)[blue_max] / delta[blue_max]) + 4.0\n    hue = hue / 6.0\n    saturation = np.where(maximum > epsilon, delta / (maximum + epsilon), 0.0)\n    return np.stack([hue, saturation, maximum], axis=-1)\n\n\ndef hsv_to_rgb(color):\n    h, s, v = color[..., 0], color[..., 1], color[..., 2]\n    p = np.abs(((h[..., None] + np.array([0.0, 0.6666667, 0.3333333], dtype=np.float32)) % 1.0) * 6.0 - 3.0)\n    return (v[..., None] * (1.0 + s[..., None] * (np.clip(p - 1.0, 0.0, 1.0) - 1.0))).astype(np.float32)\n\n\ndef hue_distance(a, b):\n    difference = np.abs(a - b)\n    return np.minimum(difference, 1.0 - difference)\n\n\ndef adjust_saturation(color, amount):\n    gray = luma(color)[..., None]\n    factor = max(0.0, 1.0 + amount)\n    return gray + (color - gray) * factor\n\n\ndef apply_preset(color, filter_id):\n    gray = luma(color)[..., None]\n    if filter_id == 1:\n        return adjust_saturation((color - 0.5) * 1.08 + 0.5, 0.20)\n    if filter_id == 2:\n        return adjust_saturation((color - 0.5) * 1.07 + 0.5 + np.array([0.035, 0.012, -0.025], dtype=np.float32), 0.18)\n    if filter_id == 3:\n        return adjust_saturation((color - 0.5) * 1.07 + 0.5 + np.array([-0.025, 0.005, 0.035], dtype=np.float32), 0.18)\n    if filter_id == 4:\n        return adjust_saturation((color - 0.5) * 1.22 + 0.5, -0.08)\n    if filter_id == 5:\n        return adjust_saturation((color - 0.5) * 1.21 + 0.5 + np.array([0.045, 0.012, -0.035], dtype=np.float32), -0.05)\n    if filter_id == 6:\n        return adjust_saturation((color - 0.5) * 1.21 + 0.5 + np.array([-0.035, 0.004, 0.045], dtype=np.float32), -0.05)\n    if filter_id == 7:\n        return np.repeat(gray, 3, axis=-1)\n    if filter_id == 8:\n        return np.repeat(gray, 3, axis=-1) * np.array([1.06, 1.02, 0.92], dtype=np.float32) \\\n\n\n---NEXT---\n\n{\"enregistrer\": true, \"cuire\": true, \"cook\": \"photo-apply.py\"}HTTP/1.0 200 OK\r\nServer: SimpleHTTP/0.6 Python/3.9.6\r\nDate: Wed, 09 Sep 2026 23:09:04 GMT\r\nContent-type: text/html; charset=utf-8\r\nContent-Length: 1109\r\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a0886d-1cb2-75e0-a1ec-41b4a5082ef6","create_time":1788995344.564897}}}
