ascii=False).encode()\n            self.send_response(code)\n            self.send_header(\"Content-Type\", \"application/json; charset=utf-8\")\n            self.send_header(\"Content-Length\", str(len(body)))\n            self.end_headers()\n            self.wfile.write(body)\n\n        def do_GET(self):\n            if self.path.rstrip(\"/\") == \"/zr-capacites\":\n                # L'outil DEMANDE ce que l'hote sait faire, au lieu de le supposer.\n                return self._json(200, {\"enregistrer\": True, \"cuire\": True, \"discard\": True, \"restore\": True, \"cook\": cook_script})\n            # Si le fichier demande est dans _deprecated, le servir depuis _deprecated\n            rel = self.path.lstrip(\"/\").split(\"?\")[0]\n            if rel and not (root / rel).exists() and (root / \"_deprecated\" / rel).is_file():\n                self.path = \"/_deprecated/\" + rel\n            return super().do_GET()\n\n        def do_POST(self):\n            route = self.path.split(\"?\")[0].rstrip(\"/\")\n            if route not in (\"/zr-enregistrer\", \"/zr-cuire\", \"/zr-discard\", \"/zr-restore\"):\n                return self._json(404, {\"ok\": False, \"erreur\": \"route inconnue\"})\n            try:\n                taille = int(self.headers.get(\"Content-Length\") or 0)\n                if taille <= 0 or taille > 64 * 1024 * 1024:\n                    raise ValueError(\"corps absent ou demesure\")\n                donnees = json.loads(self.rfile.read(taille).decode(\"utf-8\"))\n            except Exception as err:\n                return self._json(400, {\"ok\": False, \"erreur\": str(err)})\n\n            if route == \"/zr-discard\":\n                items = donnees.get(\"items\")\n                if not items:\n                    file_name = donnees.get(\"file\")\n                    image_id = donnees.get(\"id\")\n                    if not file_name:\n                        return self._json(400, {\"ok\": False, \"erreur\": \"nom de fichier manquant\"})\n                    items = [{\"id\": image_id, \"file\": file_name}]\n\n                dep_dir = root / \"_deprecated\"\n                dep_dir.mkdir(parents=True, exist_ok=True)\n\n                deplaces = []\n                ids_ecartes = set()\n                files_ecartes = set()\n\n                for item in items:\n                    fname = item.get(\"file\")\n                    iid = item.get(\"id\")\n                    if not fname:\n                        continue\n                    if iid:\n                        ids_ecartes.add(iid)\n                    files_ecartes.add(fname)\n\n                    src_file = root / fname\n                    target = dep_dir / fname\n                    if src_file.exists():\n                        shutil.move(str(src_file), str(target))\n                        deplaces.append(fname)\n                    elif target.exists():\n                        deplaces.append(fname)\n\n                index_path = instance_dir / \"_index.json\"\n                if index_path.exists():\n                    try:\n                        idx_data = json.loads(index_path.read_text(encoding=\"utf-8\"))\n                        for img in idx_data.get(\"images\", []):\n                            if img.get(\"file\") in files_ecartes or img.get(\"id\") in ids_ecartes:\n                                img[\"discarded\"] = True\n                        index_path.write_text(json.dumps(idx_data, ensure_ascii=False, indent=2) + \"\\n\", encoding=\"utf-8\")\n                    except Exception:\n                        pass\n\n                cible = instance_dir / params_name\n                if cible.exists():\n                    try:\n                        pdata = json.loads(cible.read_text(encoding=\"utf-8\"))\n                        if \"images\" in pdata:\n                            for iid in ids_ecartes:\n                                if iid in pdata[\"images\"]:\n                                    pdata[\"images\"][iid][\"discarded\"] = True\n                        cible.write_text(json.dumps(pdata, ensure_ascii=False, indent=2) + \"\\n\", encoding=\"utf-8\")\n                    except Exception:\n                        pass\n\n                return self._json(200, {\"ok\": True, \"deplaces\": deplaces, \"discarded\": True})\n\n            if route == \"/zr-restore\":\n                items = donnees.get(\"items\")\n                if not items:\n                    file_name = donnees.get(\"file\")\n                    image_id = donnees.get(\"id\")\n                    if not file_name:\n                        return self._json(400, {\"ok\": False, \"erreur\": \"nom de fichier manquant\"})\n                    items = [{\"id\": image_id, \"file\": file_name}]\n\n                dep_dir = root / \"_deprecated\"\n                restaures = []\n                ids_restaures = set()\n                files_restaures = set()\n\n                for item in items:\n                    fname = item.get(\"file\")\n                    iid = item.get(\"id\")\n                    if not fname:\n                        continue\n                    if iid:\n                        ids_restaures.add(iid)\n                    files_restaures.add(fname)\n\n                    src_file = dep_dir / fname\n                    target = root / fname\n                    if src_file.exists():\n                        shutil.move(str(src_file), str(target))\n                        restaures.append(fname)\n                    elif target.exists():\n                        restaures.append(fname)\n\n                index_path = instance_dir / \"_index.json\"\n                if index_path.exists():\n                    try:\n                        idx_data = json.loads(index_path.read_text(encoding=\"utf-8\"))\n                        for img in idx_data.get(\"images\", []):\n                            if img.get(\"file\") in files_restaures or img.get(\"id\") in ids_restaures:\n                                img[\"discarded\"] = False\n                        index_path.write_text(json.dumps(idx_data, ensure_ascii=False, indent=2) + \"\\n\", encoding=\"utf-8\")\n                    except Exception:\n                        pass\n\n                cible = instance_dir / params_name\n                if cible.exists():\n                    try:\n                        pdata = json.loads(cible.read_text(encoding=\"utf-8\"))\n                        if \"images\" in pdata:\n                            for iid in ids_restaures:\n                                if iid in pdata[\"images\"]:\n                                    pdata[\"images\"][iid][\"discarded\"] = False\n                        cible.write_text(json.dumps(pdata, ensure_ascii=False, indent=2) + \"\\n\", encoding=\"utf-8\")\n                    except Exception:\n                        pass\n\n                return self._json(200, {\"ok\": True, \"restaures\": restaures, \"discarded\": False})\n\n            if not isinstance(donnees, dict) or \"images\" not in donnees:\n                return self._json(400, {\"ok\": False, \"erreur\": \"bloc de reglages invalide\"})\n\n            cible = instance_dir / params_name\n            # Le travail precedent n'est jamais efface en silence.\n            if cible.exists():\n                archive = instance_dir / \".hda-history\"\n                archive.mkdir(exist_ok=True)\n                shutil.copy2(cible, archive / f\"{params_name}.{time.strftime('%Y%m%d-%H%M%S')}\")\n            cible.write_text(json.dumps(donnees, ensure_ascii=False, indent=2), encoding=\"utf-8\")\n\n            if route == \"/zr-enregistrer\":\n                return self._json(200, {\"ok\": True, \"fichier\": str(cible), \"action\": \"enregistre\"})\n\n            rendu = subprocess.run([sys.executable, cook_script], cwd=str(instance_dir),\n                                   capture_output=True, text=True)\n            sorties = sorted((instance_dir 